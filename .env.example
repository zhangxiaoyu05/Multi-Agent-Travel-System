# =============================================================================
# 入境定制游多 Agent 系统——环境变量配置模板
# =============================================================================
# 用法：
#   1. cp .env.example .env
#   2. 编辑 .env，填入真实 API Key 和服务地址
#   3. .env.example 提交到 Git（不含真实密钥），.env 不提交
#
# 异地部署：
#   所有服务地址均通过环境变量配置，修改 .env 即可切换环境
#   Docker Compose 部署时使用服务名（如 mysql, redis），
#   外部部署时改为实际 IP 或域名
# =============================================================================


# =============================================================================
# LLM 配置——阿里百炼平台
# https://bailian.console.aliyun.com/
# =============================================================================

# 百炼 API Key（必填）
LLM_API_KEY=sk-your-bailian-api-key-here

# 百炼兼容 OpenAI 的 base_url（不用改）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 路由模型：意图识别（平衡速度与质量）
ROUTER_MODEL=qwen-plus

# 生成模型：行程生成、客服回复（强推理、长文本）
AGENT_MODEL=qwen3-max

# Embedding 模型：向量检索
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 路由模型参数
ROUTER_TEMPERATURE=0.3
ROUTER_MAX_TOKENS=512

# 生成模型参数
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096


# =============================================================================
# MySQL 8.0——会话存储 + LangGraph Checkpoint
# =============================================================================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=travel
MYSQL_PASSWORD=travel123
MYSQL_DATABASE=travel_agent


# =============================================================================
# Redis——会话缓存 + 摘要缓存
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 会话历史缓存 TTL（秒）
REDIS_SESSION_TTL=1800
# 摘要缓存 TTL（秒）
REDIS_SUMMARY_TTL=3600


# =============================================================================
# Milvus——向量检索（单机部署）
# =============================================================================

MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=travel_knowledge


# =============================================================================
# 服务配置
# =============================================================================

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
REQUEST_TIMEOUT=60

# Checkpoint 后端：mysql（生产）| memory（开发调试，重启丢失会话）
CHECKPOINT_BACKEND=mysql

# 修订循环上限
MAX_REVISIONS=3
# 用户消息最大长度
MAX_MESSAGE_LENGTH=4000

# 工具模式：mock（默认，模拟数据）| real（真实 API）
# 当前支持 real 的工具：weather（Open-Meteo 免费 API）
# 其他工具（inventory/quote/crm/capi）为骨架，待对接外部系统
TOOL_MODE=mock


# =============================================================================
# 记忆系统——短/中/长期记忆
# =============================================================================

# 上下文窗口管理（qwen3-max: 32768 tokens）
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_SUMMARY_THRESHOLD=0.7
CONTEXT_KEEP_RECENT_ROUNDS=10

# 对话消息缓存（Redis）
CHAT_MESSAGE_REDIS_TTL=86400
# 对话消息持久化（MySQL，秒）
CHAT_MESSAGE_MYSQL_TTL=604800

# 中期偏好记忆有效期（秒，默认 60 天）
PREFERENCE_EXPIRE_SECONDS=5184000
