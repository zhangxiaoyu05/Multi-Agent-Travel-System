# =============================================================================
# 入境定制游多 Agent 系统——环境变量配置模板
# =============================================================================
# 用法：
#   1. cp .env.example .env
#   2. 编辑 .env，填入你的真实 API Key
#   3. .env.example 提交到 Git（不含真实密钥），.env 不提交
# =============================================================================


# =============================================================================
# LLM 配置——阿里百炼平台
# https://bailian.console.aliyun.com/
# =============================================================================

# 百炼 API Key（必填）
# 获取路径：百炼控制台 → 模型广场 → API-KEY 管理
LLM_API_KEY=sk-your-bailian-api-key-here

# 百炼兼容 OpenAI 的 base_url（不用改）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 模型选择 ----
# 路由模型：用于意图识别，需要快速响应、低成本
# 可选：qwen-turbo（推荐）| qwen-plus
ROUTER_MODEL=qwen-turbo

# 生成模型：用于行程生成、客服回复，需要强推理和长文本
# 可选：qwen-plus（推荐）| qwen-max | qwen-turbo
AGENT_MODEL=qwen-plus


# =============================================================================
# 模型参数
# =============================================================================

# 路由模型温度（0-1，越低越确定）
ROUTER_TEMPERATURE=0.3

# 路由模型最大输出 token 数
ROUTER_MAX_TOKENS=512

# 生成模型温度（0-1，越高越多样）
AGENT_TEMPERATURE=0.7

# 生成模型最大输出 token 数
AGENT_MAX_TOKENS=4096


# =============================================================================
# 服务配置
# =============================================================================

HOST=0.0.0.0
PORT=8000

# 日志级别：debug | info | warning | error
LOG_LEVEL=info

# API 请求超时（秒）
REQUEST_TIMEOUT=60


# =============================================================================
# 修订循环配置
# =============================================================================

# 草案最大修订次数（超出转人工）
MAX_REVISIONS=3

# 用户消息最大长度（字符数）
MAX_MESSAGE_LENGTH=4000


# =============================================================================
# 以下为后续阶段配置（当前 MVP 暂不使用）
# =============================================================================

